{
    "compilerOptions": {
        "target": "ES2018",
        "module": "Preserve",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true
    },
    "exclude": ["node_modules", "scratch", "vitest.config.ts", "tsdown.ts", "remotion.config.ts"],
    "files": ["./.markdownlint-cli2.ts", "./.lintstagedrc.ts"],
    "include": ["./*.ts"]
}
